{
  "name": "media-planning-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "chcp 65001>nul && node scripts/generate-hello-path.mjs && node scripts/build-electron.mjs && node scripts/dev-desktop.mjs",
    "clean:test": "powershell -ExecutionPolicy Bypass -File scripts/clean-test-artifacts.ps1",
    "start": "electron .",
    "smoke": "npm run build && npm run prepare:media && node scripts/smoke-desktop.mjs",
    "prepare:media": "powershell -ExecutionPolicy Bypass -File scripts/prepare-media.ps1",
    "verify": "tsc --noEmit && vitest run src electron/projectSettings.test.ts electron/devDirectories.test.ts && npm run test:e2e",
    "test:e2e": "npm run prepare:media && npm run build && playwright test",
    "build": "node scripts/generate-hello-path.mjs && tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "dist:win": "npm run build && npm run prepare:media && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.0.0",
    "@tiptap/extension-font-family": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "konva": "^9.3.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "local.media.planning",
    "productName": "音视频创作策划工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    }
  }
}
